# Variáveis de ambiente da API (configure no painel da Vercel → Settings → Environment Variables).
# NUNCA coloque valores reais neste arquivo.

# Chave secreta do Stripe (sk_test_... em testes, sk_live_... em produção) — apenas no servidor
STRIPE_SECRET_KEY=

# Chave web do Firebase (opcional; padrão = a chave pública do index.html) — valida o token do usuário
FIREBASE_API_KEY=

# Origens que podem chamar a API pelo navegador (opcional; padrão = Vercel + GitHub Pages)
ALLOWED_ORIGINS=https://stratum-agro.vercel.app,https://kauesn.github.io

# URL pública do site (retorno do checkout e do portal de cobrança)
SITE_URL=https://stratum-agro.vercel.app/

# IDs de preço do Stripe (opcionais; há valores padrão em lib/stripe.js)
PRICE_MENSAL=
PRICE_ANUAL=
