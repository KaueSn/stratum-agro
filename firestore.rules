rules_version = '2';

// =====================================================================
// Stratum Agro — Regras de segurança do Firestore
// Cole em: Firebase Console → Firestore Database → Regras → Publicar
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null; }
    function email()      { return signedIn() ? request.auth.token.email : ''; }
    // Master só com e-mail verificado (login Google já vem verificado)
    function isMaster()   { return signedIn() && request.auth.token.email_verified == true && email() == 'kauue.neves@gmail.com'; }
    function myData()     { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin()    { return isMaster() || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && myData().role == 'admin'); }
    function isDev()      { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && myData().role == 'dev'; }

    // Perfis de usuário
    match /users/{uid} {
      // Cada um lê o próprio perfil; admins leem todos
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Campos que o próprio usuário pode editar (site + simulador, que usa
      // o mesmo projeto Firebase). Todo o resto só o admin altera.
      function campoTexto(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
      function perfilValido(d) {
        return campoTexto(d, 'name', 80) && campoTexto(d, 'phone', 30) && campoTexto(d, 'bio', 500)
          && (!('cenarios' in d) || (d.cenarios is list && d.cenarios.size() <= 50));
      }

      // Criação do próprio documento. Só campos conhecidos; o e-mail é o do
      // token; cargo nasce 'user' (ou 'admin' para o master); assinatura nasce 'trial'.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'plan', 'status', 'subscription',
             'subscriptionStart', 'subscriptionEnd', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == (isMaster() ? 'admin' : 'user')
        && request.resource.data.status == 'active'
        && request.resource.data.subscription == 'trial'
        && request.resource.data.get('plan', 'acess') == 'acess'
        && perfilValido(request.resource.data);

      // O dono edita apenas nome, telefone, bio e cenários (lista explícita:
      // não pode mudar e-mail, cargo, plano, assinatura, datas nem status). Admin pode tudo.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'phone', 'bio', 'cenarios', 'updatedAt'])
        && perfilValido(request.resource.data)
      );

      allow delete: if isAdmin();
    }

    // Configurações públicas da plataforma (ex.: habilitar pagamentos)
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Conteúdo editável do site (via painel do dev/admin). O campo `js` roda
    // para todos os visitantes, então só o master o altera (S4); o HTML é
    // filtrado no navegador (limparHtml).
    match /site/{doc} {
      function jsAntes() { return resource == null ? '' : resource.data.get('js', ''); }
      allow read: if true;
      allow create, update: if isMaster()
        || ((isAdmin() || isDev()) && request.resource.data.get('js', '') == jsAntes());
      allow delete: if isMaster();
    }

    // Comunidade do simulador (boitel-analytics-pro → js/community.js).
    // Só usuários logados leem; cada um publica em seu nome e apaga o que é seu.
    function textoOk(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    match /community_posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'autor', 'tipo', 'titulo', 'texto', 'criadoEm', 'respostas'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['pergunta', 'artigo']
        && textoOk(request.resource.data.autor, 80)
        && textoOk(request.resource.data.titulo, 120)
        && textoOk(request.resource.data.texto, 5000)
        && textoOk(request.resource.data.criadoEm, 40)
        && request.resource.data.respostas == 0;
      // O único campo que outros alteram é o contador de respostas, de 1 em 1
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostas'])
        && request.resource.data.respostas == resource.data.get('respostas', 0) + 1;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /community_answers/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId', 'uid', 'autor', 'texto', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && textoOk(request.resource.data.postId, 128)
        && exists(/databases/$(database)/documents/community_posts/$(request.resource.data.postId))
        && textoOk(request.resource.data.autor, 80)
        && textoOk(request.resource.data.texto, 5000)
        && textoOk(request.resource.data.criadoEm, 40);
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Qualquer outro caminho: bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
